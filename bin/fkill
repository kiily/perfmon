#!/bin/bash
# fkill — fuzzy-find and kill processes. Memory-sorted list, fzf multi-select.
# Usage: fkill [-9] [query]                    interactive (query pre-fills the fzf filter)
#        fkill [-9] --match REGEX [--force]    non-interactive: kill all COMMAND matches
#        fkill --list [--match REGEX | query]  print candidates without killing, exit 0
# --match is case-insensitive and applies to the COMMAND column only (never PID/MEM).
# More than 5 matches requires --force. Exit: 1 = no match/refused, 2 = a kill failed.
set -eu

SIG=TERM
MATCH=""
QUERY=""
PORT=""
LIST=0
FORCE=0
WAIT=5
ESCALATE=0

while [ $# -gt 0 ]; do
  case "$1" in
    -9|--kill) SIG=KILL; shift ;;
    --match)
      [ $# -ge 2 ] || { echo "fkill: missing value for --match" >&2; exit 1; }
      MATCH="$2"; shift 2 ;;
    --port)
      [ $# -ge 2 ] || { echo "fkill: missing value for --port" >&2; exit 1; }
      [[ "$2" =~ ^[0-9]+$ ]] && [ "$2" -ge 1 ] && [ "$2" -le 65535 ] || {
        echo "fkill: --port must be 1-65535" >&2; exit 1; }
      PORT="$2"; shift 2 ;;
    --list) LIST=1; shift ;;
    --force) FORCE=1; shift ;;
    --escalate) ESCALATE=1; shift ;;
    --wait)
      [ $# -ge 2 ] || { echo "fkill: missing value for --wait" >&2; exit 1; }
      [[ "$2" =~ ^[1-9][0-9]*$ ]] || { echo "fkill: --wait must be a positive integer (seconds)" >&2; exit 1; }
      WAIT="$2"; shift 2 ;;
    -h|--help) sed -n '2,7p' "$0"; exit 0 ;;
    *) QUERY="$1"; shift ;;
  esac
done

# Never offer: this script, its shell ancestry, or the herdr server/client.
excluded_pids() {
  local p=$$
  while [ "$p" -gt 1 ]; do
    echo "$p"
    p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ') || break
    [ -z "$p" ] && break
  done
  pgrep -f '[h]erdr' 2>/dev/null || true
}

EXCLUDE=$(excluded_pids | sort -u)
MY_PGID=$(ps -o pgid= -p $$ | tr -d ' ')

# Candidate list: "MEM(MB)  PID  COMMAND", memory-sorted descending.
# Skips excluded PIDs and anything in fkill's own process group (its pipeline
# helpers show up in the ps snapshot and must never be kill targets).
# Optional $1: case-insensitive ERE applied to the COMMAND column only, with
# the command's original spacing preserved (passed via env to avoid awk -v
# backslash mangling). Optional $2: space-separated PID allowlist — only those
# PIDs are emitted (exclusions still apply on top).
candidates() {
  local re="${1:-}" pids="${2:-}"
  ps -axo rss=,pgid=,pid=,command= | sort -rn | \
    MATCH_RE="$re" PID_FILTER="$pids" awk -v excl="$(echo "$EXCLUDE" | tr '\n' ' ')" -v mypgid="$MY_PGID" '
    BEGIN {
      n=split(excl, arr, " "); for (i=1;i<=n;i++) skip[arr[i]]=1
      re=tolower(ENVIRON["MATCH_RE"])
      m=split(ENVIRON["PID_FILTER"], parr, " "); for (i=1;i<=m;i++) if (parr[i] != "") { only[parr[i]]=1; filtered=1 }
    }
    {
      rss=$1; pgid=$2; pid=$3
      line=$0   # strip the three numeric columns from the ORIGINAL text — spacing intact
      sub(/^[[:space:]]*[0-9]+[[:space:]]+[0-9]+[[:space:]]+[0-9]+[[:space:]]+/, "", line)
      if (pid in skip || pgid == mypgid) next
      if (filtered && !(pid in only)) next
      if (re != "" && tolower(line) !~ re) next
      printf "%8.0f  %-6s %s\n", rss/1024, pid, line
    }'
}

# TCP LISTEN owner(s) of a port, one PID per line. lsof exits 1 with empty
# output when nothing listens (or the listener belongs to another user).
port_pids() { lsof -nP -tiTCP:"$1" -sTCP:LISTEN 2>/dev/null || true; }

# Selectors are mutually exclusive: --match | --port | interactive query.
if [ -n "$PORT" ] && { [ -n "$MATCH" ] || [ -n "$QUERY" ]; }; then
  echo "fkill: --port cannot be combined with --match or a query" >&2; exit 1
fi

if [ "$LIST" -eq 1 ]; then
  if [ -n "$PORT" ]; then
    # Empty PID set must never reach candidates(): an empty filter means
    # "no filter", which would list (or worse, select) every process.
    PORT_PIDS=$(port_pids "$PORT")
    [ -n "$PORT_PIDS" ] && candidates "" "$PORT_PIDS"
  else
    candidates "${MATCH:-$QUERY}"
  fi
  exit 0
fi

if [ -n "$PORT" ]; then
  PORT_PIDS=$(port_pids "$PORT")
  [ -z "$PORT_PIDS" ] && {
    echo "fkill: no killable listener on port $PORT (nothing listening, or owned by another user)" >&2
    exit 1
  }
  SELECTED=$(candidates "" "$PORT_PIDS")
  [ -z "$SELECTED" ] && {
    echo "fkill: listener on port $PORT is excluded (fkill never targets itself or herdr)" >&2
    exit 1
  }
elif [ -n "$MATCH" ]; then
  SELECTED=$(candidates "$MATCH")
  [ -z "$SELECTED" ] && { echo "fkill: no candidates match: $MATCH" >&2; exit 1; }
else
  SELECTED=$(candidates | fzf --multi \
    --header="MEM(MB)   PID    COMMAND   —   tab: multi-select, enter: kill (SIG$SIG)" \
    --query="$QUERY" \
    --preview 'ps -p {2} -o pid,ppid,%cpu,%mem,rss,etime,command | fold -w $FZF_PREVIEW_COLUMNS' \
    --preview-window=down,4) || true
  [ -z "$SELECTED" ] && { echo "fkill: nothing selected"; exit 0; }
fi

# Blast-radius guard for the non-interactive selectors (interactive fzf is its
# own confirmation; the user picked each row).
if [ -n "$PORT" ] || [ -n "$MATCH" ]; then
  N=$(echo "$SELECTED" | wc -l | tr -d ' ')
  if [ "$N" -gt 5 ] && [ "$FORCE" -eq 0 ]; then
    echo "fkill: $N processes selected — refusing to kill more than 5 without --force:" >&2
    echo "$SELECTED" >&2
    exit 1
  fi
fi

# Death check: gone (ps exits nonzero / empty) or zombie (state starts with Z —
# kill -0 succeeds on zombies, so it is the wrong liveness test).
is_dead() {
  local st
  st=$(ps -p "$1" -o state= 2>/dev/null | tr -d '[:space:]') || return 0
  [ -z "$st" ] && return 0
  case "$st" in Z*) return 0 ;; *) return 1 ;; esac
}

# Poll up to $WAIT seconds (0.1s steps) for the PID to die.
wait_dead() {
  local i=0 n=$((WAIT * 10))
  while [ "$i" -lt "$n" ]; do
    is_dead "$1" && return 0
    sleep 0.1; i=$((i + 1))
  done
  is_dead "$1"
}

FAILED=0
while read -r mem pid cmd; do
  # PID-reuse guard: re-read the command and make sure it is still the process
  # we selected (prefix compare — commands can shrink in a fresh ps snapshot).
  NOW=$(ps -p "$pid" -o command= 2>/dev/null) || NOW=""
  case "$NOW" in
    "$cmd"*) ;;
    *) echo "fkill: skipping $pid — command changed since selection (now: ${NOW:-gone})" >&2
       continue ;;
  esac
  if ! kill "-$SIG" "$pid" 2>/dev/null; then
    echo "fkill: failed to signal $pid  $cmd" >&2
    FAILED=1
    continue
  fi
  # Honest reporting: "killed" only once the process is actually gone.
  if wait_dead "$pid"; then
    echo "killed (SIG$SIG) $pid  $cmd"
  elif [ "$ESCALATE" -eq 1 ] && [ "$SIG" != KILL ]; then
    kill -KILL "$pid" 2>/dev/null || true
    if wait_dead "$pid"; then
      echo "killed (SIGKILL after SIG$SIG) $pid  $cmd"
    else
      echo "fkill: $pid still running after SIGKILL  $cmd" >&2
      FAILED=1
    fi
  else
    echo "fkill: $pid still running after SIG$SIG (use --escalate or -9)  $cmd" >&2
    FAILED=1
  fi
done <<< "$SELECTED"

[ "$FAILED" -eq 0 ] || exit 2
