#!/usr/bin/env python3
"""perfweb — localhost dashboard for perfmon: live CPU/RAM hogs, one-click kill.

Usage: perfweb [--port N] [--no-open]

Binds 127.0.0.1 only and mints a random token at startup; every request needs
it. That token plus the Host check and the custom request header are what stop
any random page in your browser from POSTing to the kill endpoint.
"""
import http.server, json, os, re, secrets, signal, subprocess, sys, time
import urllib.parse, webbrowser

PORT, OPEN = 7777, True
args = sys.argv[1:]
while args:
    a = args.pop(0)
    if a == "--port":
        PORT = int(args.pop(0))
    elif a == "--no-open":
        OPEN = False
    elif a in ("-h", "--help"):
        print(__doc__.strip()); sys.exit(0)
    else:
        print(f"perfweb: unknown option {a}", file=sys.stderr); sys.exit(1)

TOKEN = secrets.token_urlsafe(16)
TOTAL = int(subprocess.run(["sysctl", "-n", "hw.memsize"], capture_output=True, text=True).stdout)
# Never offer ourselves or our ancestors as victims (same rule as fkill).
SAFE = set()
p = os.getpid()
while p > 1:
    SAFE.add(p)
    out = subprocess.run(["ps", "-o", "ppid=", "-p", str(p)], capture_output=True, text=True).stdout.strip()
    p = int(out) if out.isdigit() else 0

_prev, _prev_t = {}, 0.0


def cputime(s):
    """ps TIME column ([dd-]hh:mm:ss.ss) → seconds."""
    d, _, rest = s.rpartition("-")
    secs = 0.0
    for part in rest.split(":"):
        secs = secs * 60 + float(part)
    return secs + (float(d) * 86400 if d else 0)


def procs():
    """Per-process rows with a REAL cpu%, from cpu-seconds burned since the last
    poll — ps's own %CPU is a since-launch average and useless for "what is
    ramming my machine right now"."""
    global _prev, _prev_t
    now = time.monotonic()
    elapsed = now - _prev_t
    out = subprocess.run(["ps", "-axo", "pid=,rss=,time=,comm="], capture_output=True, text=True).stdout
    cur, rows = {}, []
    for line in out.splitlines():
        m = re.match(r"\s*(\d+)\s+(\d+)\s+(\S+)\s+(.*)", line)
        if not m:
            continue
        pid, rss, t, comm = int(m[1]), int(m[2]), cputime(m[3]), m[4].strip()
        cur[pid] = t
        pct = (t - _prev[pid]) / elapsed * 100 if elapsed > 0 and pid in _prev else 0.0
        rows.append({"pid": pid, "mb": rss / 1024, "cpu": round(max(pct, 0.0), 1),
                     "name": comm.rsplit("/", 1)[-1], "path": comm,
                     "safe": pid in SAFE or pid <= 1})
    _prev, _prev_t = cur, now
    return rows


def headline():
    free = subprocess.run(["memory_pressure", "-Q"], capture_output=True, text=True).stdout
    free = next((l.split(": ")[-1].strip() for l in free.splitlines() if "percentage" in l), "n/a")
    swap = subprocess.run(["sysctl", "-n", "vm.swapusage"], capture_output=True, text=True).stdout
    used = re.search(r"used = ([\d.]+)M", swap)
    tot = re.search(r"total = ([\d.]+)M", swap)
    return {"free": free, "swap_used": round(float(used[1]) / 1024, 1) if used else 0,
            "swap_total": round(float(tot[1]) / 1024, 1) if tot else 0,
            "ram_gb": round(TOTAL / 1073741824)}


def kill(pid, sig):
    if pid in SAFE or pid <= 1:
        return {"ok": False, "msg": f"{pid} is perfweb itself or an ancestor — refused"}
    name = subprocess.run(["ps", "-p", str(pid), "-o", "comm="], capture_output=True, text=True).stdout.strip()
    if not name:
        return {"ok": True, "msg": f"{pid} was already gone"}
    try:
        os.kill(pid, signal.SIGKILL if sig == "KILL" else signal.SIGTERM)
    except OSError as e:
        return {"ok": False, "msg": f"could not signal {pid}: {e.strerror}"}
    for _ in range(20):  # verify death, like fkill — never claim a kill we did not land
        time.sleep(0.1)
        st = subprocess.run(["ps", "-p", str(pid), "-o", "state="],
                            capture_output=True, text=True).stdout.strip()
        if not st or st.startswith("Z"):  # gone, or a zombie (kill -0 lies about those)
            return {"ok": True, "msg": f"killed {pid} {name.rsplit('/', 1)[-1]}"}
    return {"ok": False, "msg": f"{pid} survived SIG{sig} — try force kill"}


PAGE = r"""<!doctype html><meta charset=utf-8><title>perfmon</title>
<meta name=viewport content="width=device-width,initial-scale=1">
<style>
:root{--bg:#0f1115;--card:#171a21;--line:#252a34;--fg:#e6e9ef;--dim:#7d8698;
      --hot:#ff5f56;--warm:#ffbd2e;--cool:#5ac8fa;--ok:#28c840}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font:14px/1.5 ui-monospace,SFMono-Regular,Menlo,monospace}
.wrap{max-width:820px;margin:0 auto;padding:28px 20px 60px}
h1{font-size:15px;letter-spacing:.14em;text-transform:uppercase;color:var(--dim);margin:0 0 18px;font-weight:600}
h1 b{color:var(--fg);font-weight:600}
.bar{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:22px}
.stat{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:10px 14px;flex:1;min-width:130px}
.stat span{display:block;color:var(--dim);font-size:11px;letter-spacing:.1em;text-transform:uppercase}
.stat b{font-size:20px;font-weight:600}
.hogs{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:22px}
@media(max-width:620px){.hogs{grid-template-columns:1fr}}
.hog{background:var(--card);border:1px solid var(--line);border-left:3px solid var(--hot);
     border-radius:10px;padding:14px}
.hog em{font-style:normal;color:var(--dim);font-size:11px;letter-spacing:.1em;text-transform:uppercase}
.hog .n{font-size:15px;margin:6px 0 2px;word-break:break-all}
.hog .v{color:var(--warm);font-size:22px;font-weight:600}
table{width:100%;border-collapse:collapse}
th{text-align:left;color:var(--dim);font-weight:500;font-size:11px;letter-spacing:.1em;
   text-transform:uppercase;padding:6px 8px;border-bottom:1px solid var(--line);cursor:pointer;user-select:none}
th.on{color:var(--cool)}
td{padding:6px 8px;border-bottom:1px solid #1c1f27;vertical-align:middle}
tr:hover td{background:#1a1e26}
.num{text-align:right;font-variant-numeric:tabular-nums;width:80px}
.pid{color:var(--dim);width:70px}
.name{word-break:break-all}
.hot{color:var(--hot)}.warm{color:var(--warm)}
button{background:#20242d;color:var(--fg);border:1px solid var(--line);border-radius:6px;
       padding:3px 10px;font:inherit;font-size:12px;cursor:pointer}
button:hover{border-color:var(--hot);color:var(--hot)}
button:disabled{opacity:.25;cursor:not-allowed}
.k{width:1%;white-space:nowrap}
#toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);background:var(--card);
       border:1px solid var(--line);border-radius:8px;padding:9px 16px;opacity:0;transition:opacity .2s}
#toast.show{opacity:1}
.foot{color:var(--dim);font-size:12px;margin-top:18px}
</style>
<div class=wrap>
<h1><b>perfmon</b> · localhost</h1>
<div class=bar id=bar></div>
<div class=hogs id=hogs></div>
<table><thead><tr>
  <th class=num data-s=cpu>cpu %</th><th class=num data-s=mb>mem gb</th>
  <th class=pid>pid</th><th>process</th><th></th>
</tr></thead><tbody id=rows></tbody></table>
<p class=foot>refreshes every 2s · kill sends SIGTERM, hold <kbd>shift</kbd> for SIGKILL</p>
</div>
<div id=toast></div>
<script>
const T = new URLSearchParams(location.search).get('t');
let sort = 'cpu', last = [];
const api = (p, o = {}) => fetch(p + (p.includes('?') ? '&' : '?') + 't=' + T,
  {...o, headers: {'X-Perfweb': '1', 'Content-Type': 'application/json'}}).then(r => r.json());
const toast = m => { const e = document.getElementById('toast');
  e.textContent = m; e.className = 'show'; setTimeout(() => e.className = '', 2600); };
const gb = mb => (mb / 1024).toFixed(2);

function draw(d) {
  last = d.procs;
  const swapPct = d.head.swap_total ? Math.round(d.head.swap_used / d.head.swap_total * 100) : 0;
  document.getElementById('bar').innerHTML = `
    <div class=stat><span>ram free</span><b>${d.head.free}</b></div>
    <div class=stat><span>ram total</span><b>${d.head.ram_gb} GB</b></div>
    <div class=stat><span>swap</span><b>${d.head.swap_used}G <small style="color:var(--dim)">/ ${d.head.swap_total}G · ${swapPct}%</small></b></div>`;

  const byCpu = [...d.procs].sort((a, b) => b.cpu - a.cpu)[0] || {};
  const byMem = [...d.procs].sort((a, b) => b.mb - a.mb)[0] || {};
  document.getElementById('hogs').innerHTML = [
    ['worst cpu', byCpu, byCpu.cpu + ' %'], ['worst memory', byMem, gb(byMem.mb) + ' GB']
  ].map(([t, p, v]) => `<div class=hog><em>${t}</em><div class=v>${v}</div>
      <div class=n>${p.name || '—'}</div>
      <div><button ${p.safe ? 'disabled' : ''} onclick="doKill(event,${p.pid})">kill ${p.pid}</button></div>
    </div>`).join('');

  const rows = [...d.procs].sort((a, b) => b[sort] - a[sort]).slice(0, 25);
  document.getElementById('rows').innerHTML = rows.map(p => `<tr>
    <td class="num ${p.cpu > 80 ? 'hot' : p.cpu > 25 ? 'warm' : ''}">${p.cpu.toFixed(1)}</td>
    <td class="num ${p.mb > 2048 ? 'hot' : p.mb > 700 ? 'warm' : ''}">${gb(p.mb)}</td>
    <td class=pid>${p.pid}</td><td class=name title="${p.path}">${p.name}</td>
    <td class=k><button ${p.safe ? 'disabled' : ''} onclick="doKill(event,${p.pid})">kill</button></td>
  </tr>`).join('');
  document.querySelectorAll('th[data-s]').forEach(th => th.classList.toggle('on', th.dataset.s === sort));
}

function doKill(ev, pid) {
  const sig = ev.shiftKey ? 'KILL' : 'TERM';
  ev.target.disabled = true;
  api('/api/kill', {method: 'POST', body: JSON.stringify({pid, sig})})
    .then(r => { toast(r.msg); tick(); })
    .catch(() => toast('request failed'));
}

document.querySelectorAll('th[data-s]').forEach(th =>
  th.onclick = () => { sort = th.dataset.s; draw({head: cachedHead, procs: last}); });

let cachedHead = {};
const tick = () => api('/api/stats').then(d => { cachedHead = d.head; draw(d); }).catch(() => {});
tick(); setInterval(tick, 2000);
</script>
"""


class H(http.server.BaseHTTPRequestHandler):
    def _guard(self):
        # localhost-only + token: a page on some other origin can neither guess
        # the token nor set X-Perfweb without a preflight we never answer.
        host = self.headers.get("Host", "").split(":")[0]
        if host not in ("127.0.0.1", "localhost"):
            return self._send(403, {"msg": "bad host"})
        q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
        if not secrets.compare_digest(q.get("t", [""])[0], TOKEN):
            return self._send(403, {"msg": "bad token"})
        return True

    def _send(self, code, obj, ctype="application/json"):
        body = obj if isinstance(obj, bytes) else json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)
        return code == 200

    def do_GET(self):
        if self.path.startswith("/api/stats"):
            if self._guard() is not True:
                return
            self._send(200, {"head": headline(), "procs": procs()})
        elif self.path.startswith("/?") or self.path == "/":
            if self._guard() is not True:
                return
            self._send(200, PAGE.encode(), "text/html; charset=utf-8")
        else:
            self._send(404, {"msg": "no"})

    def do_POST(self):
        if not self.path.startswith("/api/kill"):
            return self._send(404, {"msg": "no"})
        if self._guard() is not True:
            return
        if self.headers.get("X-Perfweb") != "1":
            return self._send(403, {"msg": "missing X-Perfweb header"})
        n = int(self.headers.get("Content-Length", 0))
        try:
            req = json.loads(self.rfile.read(n) or b"{}")
            pid = int(req["pid"])
        except (ValueError, KeyError, TypeError):
            return self._send(400, {"ok": False, "msg": "bad request"})
        self._send(200, kill(pid, "KILL" if req.get("sig") == "KILL" else "TERM"))

    def log_message(self, *a):
        pass


if __name__ == "__main__":
    procs()  # prime the cpu baseline so the first poll shows real numbers
    url = f"http://127.0.0.1:{PORT}/?t={TOKEN}"
    srv = http.server.ThreadingHTTPServer(("127.0.0.1", PORT), H)
    print(f"perfweb: {url}\nperfweb: ctrl-c to stop", flush=True)
    if OPEN:
        webbrowser.open(url)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\nperfweb: stopped")
